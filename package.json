{
  "name": "n8n-nodes-universal-chatmodel",
  "version": "1.0.34",
  "description": "Production-oriented n8n community Chat Model for native Google Gemini and OpenAI-compatible APIs",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "chat-model",
    "ai-agent",
    "gemini",
    "openai-compatible",
    "deepseek",
    "ollama",
    "lmstudio",
    "localai",
    "vllm",
    "langchain"
  ],
  "author": "Gabriel Santos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielsantos-alves/n8n-nodes-universal-chatmodel.git"
  },
  "homepage": "https://github.com/gabrielsantos-alves/n8n-nodes-universal-chatmodel#readme",
  "bugs": {
    "url": "https://github.com/gabrielsantos-alves/n8n-nodes-universal-chatmodel/issues"
  },
  "main": "dist/nodes/UniversalChatModel/UniversalChatModel.node.js",
  "types": "dist/nodes/UniversalChatModel/UniversalChatModel.node.d.ts",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22 <25"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc && node scripts/copy-assets.cjs",
    "dev": "tsc --watch",
    "test": "npm run build && node --test tests/*.test.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "prepare": "npm run build",
    "prepack": "npm test && npm run verify:package"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/UniversalChatModel/UniversalChatModel.node.js"
    ],
    "credentials": [
      "dist/credentials/GoogleGeminiApi.credentials.js",
      "dist/credentials/OpenAiCompatibleApi.credentials.js"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "0.24.0",
    "@langchain/core": "1.2.4",
    "@langchain/google-genai": "2.1.24",
    "@langchain/openai": "1.5.5"
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.32.1 <3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "langchain-core-n8n-2326": "npm:@langchain/core@1.2.0",
    "n8n-workflow": "2.32.1",
    "typescript": "^5.3.3",
    "zod": "3.25.67"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
